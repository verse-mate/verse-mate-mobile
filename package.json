{
  "name": "verse-mate-mobile",
  "main": "index.js",
  "version": "1.7.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "web:export": "expo export --platform web",
    "web:deploy": "expo export --platform web && bunx wrangler deploy --env preview",
    "format": "biome format --write app components hooks constants utils types scripts __tests__ src services",
    "lint": "biome check app components hooks constants utils types scripts __tests__ src services && eslint .",
    "lint:fix": "biome check --write app components hooks constants utils types scripts __tests__ src services && eslint --fix .",
    "type-check": "node --max-old-space-size=8192 ./node_modules/typescript/bin/tsc --noEmit",
    "test": "cross-env EXPO_USE_STATIC_RENDERING=1 jest",
    "test:watch": "cross-env EXPO_USE_STATIC_RENDERING=1 jest --watch",
    "test:coverage": "cross-env EXPO_USE_STATIC_RENDERING=1 jest --coverage",
    "test:ci": "cross-env EXPO_USE_STATIC_RENDERING=1 jest --ci --coverage --maxWorkers=2",
    "test:direct-branch": "cross-env EXPO_USE_STATIC_RENDERING=1 jest --changedSince=origin/main --no-coverage --passWithNoTests --maxWorkers=2",
    "test:slow": "cross-env EXPO_USE_STATIC_RENDERING=1 RUN_SLOW_TESTS=1 NODE_OPTIONS=--max-old-space-size=8192 jest --testPathPattern=\\.slow\\. --no-coverage",
    "storybook:generate": "sb-rn-get-stories",
    "chromatic:deploy": "chromatic --build-script-name storybook:generate",
    "maestro:test": "maestro test .maestro",
    "maestro:test:ios": "maestro test .maestro --device 'iPhone 15'",
    "maestro:test:android": "maestro test .maestro --device emulator-5554",
    "maestro:studio": "maestro studio",
    "capture:page": "bun run scripts/visual-reference/capture-page.ts",
    "capture:journey": "bun run scripts/visual-reference/capture-journey-replay.ts",
    "generate:api": "npx @hey-api/openapi-ts",
    "diagnose:google-sso": "bun run scripts/diagnose-google-sso.ts",
    "prepare": "husky",
    "validate": "bun run lint && bun run type-check && bun run test"
  },
  "dependencies": {
    "@bacons/apple-targets": "^4.0.7",
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-community/slider": "5.2.0",
    "@react-native-google-signin/google-signin": "^16.0.0",
    "@tanstack/react-query": "^5.90.2",
    "@types/semver": "^7.7.1",
    "@versemate/bible-search": "github:verse-mate/verse-mate-bible-search#077f4e61bb92324c693b5de03ed30e90d35ed77a",
    "@versemate/dotted-underline-text": "file:./modules/dotted-underline-text",
    "@versemate/lexicon": "github:verse-mate/verse-mate-lexicon#cdd0e8f",
    "@versemate/red-letter": "github:verse-mate/verse-mate-red-letter#650d08c",
    "@versemate/studies": "github:verse-mate/verse-mate-studies#b91fa3ca9bbdaf0ccf27d290ebba2b7ff68f593f",
    "@versemate/visuals": "github:verse-mate/verse-mate-visuals#6e8a427",
    "axios": "^1.12.2",
    "expo": "~57.0.31",
    "expo-apple-authentication": "~57.0.2",
    "expo-application": "~57.0.3",
    "expo-asset": "~57.0.20",
    "expo-audio": "~57.0.5",
    "expo-build-properties": "~57.0.22",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.22",
    "expo-dev-client": "~57.0.20",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.13",
    "expo-localization": "~57.0.2",
    "expo-location": "~57.0.22",
    "expo-navigation-bar": "~57.0.3",
    "expo-notifications": "~57.0.24",
    "expo-router": "~57.0.29",
    "expo-screen-orientation": "~57.0.3",
    "expo-secure-store": "~57.0.4",
    "expo-sensors": "~57.0.3",
    "expo-sharing": "~57.0.24",
    "expo-speech-recognition": "~57.1.1",
    "expo-splash-screen": "~57.0.10",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.26",
    "expo-web-browser": "~57.0.3",
    "i18next": "^26.0.8",
    "jwt-decode": "^4.0.0",
    "posthog-react-native": "^4.13.0",
    "posthog-react-native-session-replay": "^1.2.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.6",
    "react-native": "0.86.3",
    "react-native-android-widget": "^0.20.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-markdown-display": "^7.0.2",
    "react-native-modal": "^14.0.0-rc.1",
    "react-native-pager-view": "8.0.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "react-native-youtube-iframe": "^2.4.1",
    "semver": "^7.8.1",
    "suncalc": "^1.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@expo/fingerprint": "~0.20.14",
    "@hey-api/openapi-ts": "^0.85.0",
    "@playwright/test": "^1.55.1",
    "@storybook/addon-ondevice-actions": "^9.1.4",
    "@storybook/addon-ondevice-backgrounds": "^9.1.4",
    "@storybook/addon-ondevice-controls": "^9.1.4",
    "@storybook/addon-ondevice-notes": "^9.1.4",
    "@storybook/react-native": "^9.1.4",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/bun": "^1.2.22",
    "@types/jest": "^29.5.0",
    "@types/react": "~19.2.4",
    "@types/react-test-renderer": "^19.1.0",
    "@types/suncalc": "^1.9.2",
    "ajv": "^8.17.1",
    "baseline-browser-mapping": "^2.8.30",
    "chromatic": "^13.3.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.25.0",
    "eslint-config-biome": "^2.1.3",
    "eslint-config-expo": "~57.0.2",
    "eslint-plugin-i18next": "^6.1.4",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "husky": "^9.1.7",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "lint-staged": "^16.1.6",
    "msw": "^2.11.3",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3",
    "undici": "^7.16.0",
    "zod-validation-error": "^4"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "biome check --write --no-errors-on-unmatched",
      "eslint --fix"
    ]
  },
  "bun": {
    "test": {
      "preload": "./test-setup.ts",
      "timeout": 1e4
    }
  },
  "private": true
}
